{
  "crons": [
    {
      "path": "/api/cron/keep-supabase-alive",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/cron/keep-supabase-alive",
      "destination": "/api/cron/keep-supabase-alive"
    },
    {
      "source": "/api/seo-injector",
      "destination": "/api/seo-injector"
    },
    {
      "source": "/api/:path*",
      "destination": "https://real-estate-website-wj16.onrender.com/api/:path*"
    },
    {
      "source": "/properties/(.*)",
      "destination": "/api/seo-injector"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}